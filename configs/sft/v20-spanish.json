{
  "output_name": "v20-spanish",
  "notes": "Spanish-only non-thinking SFT for language-specialist adapter merge experiment. Target 10k train examples. Uses Spanish HEAD-QA, BOE legislation, CCSE, DEMRE, INCLUDE, Global PIQA, Global MMLU, and MMLU-ProX. Benchmark filtering uses the full benchmarks/ directory.",
  "mode": "non_thinking",
  "non_thinking_style": "boxed_only",
  "enable_test_split": false,

  "max_per_language": 10000,
  "max_per_dataset": 30000,
  "max_per_language_mixed": 10000,
  "max_per_language_mixed_val": 800,

  "benchmark_path": "multilingual/data/benchmarks",

  "dataset_registry": {
    "include": {
      "languages": ["spanish"],
      "loader": "include",
      "mode": "as_is",
      "max_per_language": 800,
      "max_per_dataset": 800,
      "split_caps": { "val": 100, "test": 0 }
    },

    "global_piqa": {
      "languages": ["spanish"],
      "loader": "global_piqa",
      "mode": "as_is",
      "max_per_language": 205,
      "max_per_dataset": 205,
      "split_caps": { "val": 40, "test": 0 }
    },

    "global_mmlu": {
      "languages": ["spanish"],
      "loader": "global_mmlu",
      "max_per_language": 3000,
      "max_per_dataset": 3000,
      "split_caps": { "val": 120, "test": 0 }
    },

    "mmlu_prox": {
      "languages": ["spanish"],
      "loader": "mmlu_prox",
      "max_per_language": 3000,
      "max_per_dataset": 3000,
      "split_caps": { "val": 120, "test": 0 }
    },

    "head_qa": {
      "languages": ["spanish"],
      "loader": "head_qa",
      "max_per_language": 2000,
      "max_per_dataset": 2000,
      "split_caps": { "val": 200, "test": 0 }
    },

    "spain_boe_legislation": {
      "languages": ["spanish"],
      "loader": "spain_boe_legislation",
      "max_per_language": 900,
      "max_per_dataset": 900,
      "split_caps": { "val": 100, "test": 0 }
    },

    "ccse": {
      "languages": ["spanish"],
      "loader": "ccse",
      "max_per_language": 400,
      "max_per_dataset": 400,
      "split_caps": {"val": 50, "test": 0 }
    },

    "demre": {
      "languages": ["spanish"],
      "loader": "demre",
      "max_per_language": 45,
      "max_per_dataset": 45,
      "split_caps": { "train": 45, "val": 0, "test": 0 }
    }
  }
}
