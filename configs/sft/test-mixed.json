{
  "output_name": "test-mixed",
  "mode": "mixed",

  "distilled_dirs": [
    "multilingual/data/distilled/v2_fallback/sft_1"
  ],

  "thinking_fraction": 0.5,
  "apply_ratio_per_language": true,

  "thinking_style": "full_thinking",
  "non_thinking_style": "boxed_only",

  "enable_test_split": false,
  "distilled_val_fraction": 0.15,
  "distilled_test_fraction": 0.0,

  "max_per_language": 5000,
  "max_per_dataset": 10000,
  "max_per_language_mixed": 2000,
  "max_per_language_mixed_val": 500,

  "benchmark_path": "multilingual/data/benchmarks/benchmark_all.jsonl",

  "dataset_registry": {
    "include": {
      "languages": ["italian", "spanish", "russian", "chinese", "hindi"],
      "loader": "include",
      "mode": "recarve",
      "split_caps": {
        "train": 0,
        "val": null,
        "test": 0
      }
    },

    "global_piqa": {
      "languages": ["italian", "spanish", "russian", "chinese", "hindi"],
      "loader": "global_piqa",
      "mode": "recarve",
      "max_per_dataset": 2000,
      "split_caps": {
        "train": 0,
        "val": 300,
        "test": 0
      }
    },

    "global_mmlu": {
      "languages": ["russian", "chinese", "hindi", "italian", "spanish"],
      "loader": "global_mmlu",
      "language_caps": {
        "russian": 2000,
        "chinese": 800,
        "hindi": 800,
        "italian": 2000,
        "spanish": 2000
      },
      "max_per_dataset": 5000,
      "split_caps": {
        "val": 500,
        "test": 0
      }
    },

    "ceval": {
      "languages": ["chinese"],
      "loader": "ceval",
      "language_caps": {
        "chinese": 5000
      },
      "max_per_dataset": 5000,
      "split_caps": {
        "val": 300,
        "test": 0
      }
    },

    "milu": {
      "languages": ["hindi"],
      "loader": "milu",
      "max_per_language": 5000,
      "max_per_dataset": 5000,
      "split_caps": {
        "val": 300,
        "test": 0
      }
    },

    "mera": {
      "languages": ["russian"],
      "loader": "mera",
      "max_per_language": 3000,
      "max_per_dataset": 3000,
      "stratify_by": "subset",
      "subject_caps": {
        "mamuramu": 285,
        "ruopenbookqa": 600,
        "ruworldtree": 115,
        "mathlogicqa": 150,
        "parus": 0,
        "use": 0,
        "rcb": 0,
        "rwsd": 0
      },
      "split_caps": {
        "val": 200,
        "test": 0
      }
    },

    "head_qa": {
      "languages": ["spanish", "italian"],
      "loader": "head_qa",
      "language_caps": {
        "spanish": 1500,
        "italian": 1000
      },
      "max_per_dataset": 2500,
      "split_caps": {
        "val": 200,
        "test": 0
      }
    },

    "exams": {
      "languages": ["italian", "spanish"],
      "loader": "exams",
      "max_per_dataset": 2000,
      "split_caps": {
        "val": 200,
        "test": 0
      }
    },

    "polizia_di_stato_clean": {
      "languages": ["italian"],
      "loader": "polizia_di_stato",
      "max_per_language": 2000,
      "max_per_dataset": 2000,
      "split_caps": {
        "val": 200,
        "test": 0
      }
    },

    "quaderno_prefettizia_clean": {
      "languages": ["italian"],
      "loader": "quaderno_prefettizia",
      "max_per_language": 2500,
      "max_per_dataset": 2500,
      "split_caps": {
        "val": 250,
        "test": 0
      }
    },

    "quaderno_prefettizia_economia_politica_clean": {
      "languages": ["italian"],
      "loader": "quaderno_prefettizia_economia_politica",
      "max_per_language": 1000,
      "max_per_dataset": 1000,
      "split_caps": {
        "val": 150,
        "test": 0
      }
    },

    "italian_civil_code": {
      "languages": ["italian"],
      "loader": "italian_civil_code",
      "max_per_language": 1500,
      "max_per_dataset": 1500,
      "split_caps": {
        "val": 150,
        "test": 0
      }
    },

    "spain_boe_legislation": {
      "languages": ["spanish"],
      "loader": "spain_boe_legislation",
      "max_per_language": 2000,
