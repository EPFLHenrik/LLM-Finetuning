{
  "output_name": "v20-italian",
  "notes": "Italian-only non-thinking SFT for language-specialist adapter merge experiment. Target 10k train examples. Uses all available Italian regional/project-specific sources with Global MMLU and MMLU-ProX as anchors. Benchmark filtering uses the full benchmarks/ directory.",
  "mode": "non_thinking",
  "non_thinking_style": "boxed_only",
  "enable_test_split": false,

  "max_per_language": 10000,
  "max_per_dataset": 30000,
  "max_per_language_mixed": 10000,
  "max_per_language_mixed_val": 800,

  "benchmark_path": "multilingual/data/benchmarks",

  "dataset_registry": {
    "include": {
      "languages": ["italian"],
      "loader": "include",
      "mode": "as_is",
      "max_per_language": 800,
      "max_per_dataset": 800,
      "split_caps": { "val": 150, "test": 0 }
    },

    "global_piqa": {
      "languages": ["italian"],
      "loader": "global_piqa",
      "mode": "as_is",
      "max_per_language": 200,
      "max_per_dataset": 200,
      "split_caps": { "val": 40, "test": 0 }
    },

    "global_mmlu": {
      "languages": ["italian"],
      "loader": "global_mmlu",
      "max_per_language": 2500,
      "max_per_dataset": 2500,
      "split_caps": { "val": 150, "test": 0 }
    },

    "mmlu_prox": {
      "languages": ["italian"],
      "loader": "mmlu_prox",
      "max_per_language": 2500,
      "max_per_dataset": 2500,
      "split_caps": { "val": 150, "test": 0 }
    },

    "head_qa": {
      "languages": ["italian"],
      "loader": "head_qa",
      "max_per_language": 1500,
      "max_per_dataset": 1500,
      "split_caps": { "val": 150, "test": 0 }
    },

    "italian_civil_code": {
      "languages": ["italian"],
      "loader": "italian_civil_code",
      "max_per_language": 1500,
      "max_per_dataset": 1500,
      "split_caps": { "val": 150, "test": 0 }
    },

    "quaderno_prefettizia": {
      "languages": ["italian"],
      "loader": "quaderno_prefettizia",
      "max_per_language": 2000,
      "max_per_dataset": 2000,
      "split_caps": { "val": 150, "test": 0 }
    },

    "polizia_di_stato": {
      "languages": ["italian"],
      "loader": "polizia_di_stato",
      "max_per_language": 600,
      "max_per_dataset": 600,
      "split_caps": { "val": 100, "test": 0 }
    },

    "quaderno_prefettizia_economia_politica": {
      "languages": ["italian"],
      "loader": "quaderno_prefettizia_economia_politica",
      "max_per_language": 500,
      "max_per_dataset": 500,
      "split_caps": { "val": 100, "test": 0 }
    }
  }
}
