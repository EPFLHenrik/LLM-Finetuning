{"id": "global_piqa_hindi_15", "dataset": "global_piqa", "language": "hindi", "task_type": "mcq", "prompt": "Agar lohe ki kadahi mein sabzi banaayi jaaye toh kya hota hai?\n\nA) Khana jaldi thanda ho jaata hai.\nB) Khana zyaada der tak garam rehta hai.", "answer": "B", "metadata": {"config": "hin_latn", "approx_cultural_score": 1, "example_id": "group0148_ex000009_hin_latn_0_v1", "source_split": "test"}, "source_id": "global_piqa_hindi_15", "split": "train", "messages": [{"role": "system", "content": ""}, {"role": "user", "content": "Agar lohe ki kadahi mein sabzi banaayi jaaye toh kya hota hai?\n\nA) Khana jaldi thanda ho jaata hai.\nB) Khana zyaada der tak garam rehta hai."}, {"role": "assistant", "content": "Lohe ki kadahi mein sabzi banaane par, loha ek achha garmi sankrantiya hai, jiske kaaran garmi ko saman roop se vitrit karta hai aur dheere-dheere garmi ko khoonta hai. Isliye, khana zyaada der tak garam rehta hai. \n\n\\boxed{B}"}], "distill": {"gold": "B", "predicted": "B", "correct": true, "valid": true, "invalid_reason": null, "used_teacher": "meta-llama/Llama-3.3-70B-Instruct", "mode": "independent", "raw": "Lohe ki kadahi mein sabzi banaane par, loha ek achha garmi sankrantiya hai, jiske kaaran garmi ko saman roop se vitrit karta hai aur dheere-dheere garmi ko khoonta hai. Isliye, khana zyaada der tak garam rehta hai. \n\n\\boxed{B}", "think_content": "", "clean": "Lohe ki kadahi mein sabzi banaane par, loha ek achha garmi sankrantiya hai, jiske kaaran garmi ko saman roop se vitrit karta hai aur dheere-dheere garmi ko khoonta hai. Isliye, khana zyaada der tak garam rehta hai. \n\n\\boxed{B}", "attempts": [{"stage": "independent", "model": "meta-llama/Llama-3.3-70B-Instruct", "attempt": 1, "temperature": 0.0, "predicted": "B", "valid": true, "invalid_reason": null, "raw": "Lohe ki kadahi mein sabzi banaane par, loha ek achha garmi sankrantiya hai, jiske kaaran garmi ko saman roop se vitrit karta hai aur dheere-dheere garmi ko khoonta hai. Isliye, khana zyaada der tak garam rehta hai. \n\n\\boxed{B}", "clean": "Lohe ki kadahi mein sabzi banaane par, loha ek achha garmi sankrantiya hai, jiske kaaran garmi ko saman roop se vitrit karta hai aur dheere-dheere garmi ko khoonta hai. Isliye, khana zyaada der tak garam rehta hai. \n\n\\boxed{B}"}]}}
