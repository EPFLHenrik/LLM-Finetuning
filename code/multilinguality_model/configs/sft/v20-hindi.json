{
  "output_name": "v20-hindi",
  "notes": "Hindi-only non-thinking SFT for language-specialist adapter merge experiment. Target 10k train examples. Uses MILU heavily, with CultSportQA, Global MMLU, MMLU-ProX, INCLUDE, and Global PIQA. Benchmark filtering uses the full benchmarks/ directory.",
  "mode": "non_thinking",
  "non_thinking_style": "boxed_only",
  "enable_test_split": false,

  "max_per_language": 10000,
  "max_per_dataset": 30000,
  "max_per_language_mixed": 10500,
  "max_per_language_mixed_val": 800,

  "benchmark_path": "data/multilinguality/benchmarks",

  "dataset_registry": {
    "include": {
      "languages": ["hindi"],
      "loader": "include",
      "mode": "as_is",
      "max_per_language": 800,
      "max_per_dataset": 800,
      "split_caps": { "val": 100, "test": 0 }
    },

    "global_piqa": {
      "languages": ["hindi"],
      "loader": "global_piqa",
      "mode": "as_is",
      "max_per_language": 200,
      "max_per_dataset": 200,
      "split_caps": { "val": 40, "test": 0 }
    },

    "global_mmlu": {
      "languages": ["hindi"],
      "loader": "global_mmlu",
      "max_per_language": 1800,
      "max_per_dataset": 1800,
      "split_caps": { "val": 150, "test": 0 }
    },

    "mmlu_prox": {
      "languages": ["hindi"],
      "loader": "mmlu_prox",
      "max_per_language": 1800,
      "max_per_dataset": 1800,
      "split_caps": { "val": 150, "test": 0 }
    },

    "milu": {
      "languages": ["hindi"],
      "loader": "milu",
      "max_per_language": 5000,
      "max_per_dataset": 5000,
      "split_caps": { "val": 150, "test": 0 }
    },

    "cultsportqa": {
      "languages": ["hindi"],
      "loader": "cultsportqa",
      "max_per_language": 1500,
      "max_per_dataset": 1500,
      "split_caps": { "val": 150, "test": 0 }
    }
  }
}
