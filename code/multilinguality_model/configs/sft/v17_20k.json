{
  "output_name": "v17_20k",
  "notes": "Non-thinking boxed-only SFT. ~20k total / ~4k per language. Moderate Global MMLU cap. Heavy MILU/CEVAL/CMMLU, moderate MERA, all INCLUDE and Global PIQA, more EXAMS/HEAD-QA, small generated Italian/Spanish cap.",
  "mode": "non_thinking",
  "non_thinking_style": "boxed_only",
  "enable_test_split": false,

  "max_per_language": 6000,
  "max_per_dataset": 20000,
  "max_per_language_mixed": 4000,
  "max_per_language_mixed_val": 400,

  "benchmark_path": "data/multilinguality/benchmarks/benchmark_all.jsonl",

  "dataset_registry": {
    "include": {
      "languages": ["italian", "spanish", "russian", "chinese", "hindi"],
      "loader": "include",
      "mode": "as_is",
      "max_per_language": 3000,
      "max_per_dataset": 15000,
      "split_caps": { "val": 500, "test": 0 }
    },

    "global_piqa": {
      "languages": ["italian", "spanish", "russian", "chinese", "hindi"],
      "loader": "global_piqa",
      "mode": "as_is",
      "max_per_language": 1500,
      "max_per_dataset": 7500,
      "split_caps": { "val": 300, "test": 0 }
    },

    "global_mmlu": {
      "languages": ["russian", "chinese", "hindi", "italian", "spanish"],
      "loader": "global_mmlu",
      "language_caps": {
        "russian": 1000,
        "chinese": 1000,
        "hindi": 1000,
        "italian": 1000,
        "spanish": 1000
      },
      "max_per_dataset": 5000,
      "split_caps": { "val": 400, "test": 0 }
    },

    "ceval": {
      "languages": ["chinese"],
      "loader": "ceval",
      "language_caps": { "chinese": 3000 },
      "max_per_dataset": 3000,
      "split_caps": { "val": 300, "test": 0 }
    },

    "cmmlu": {
      "languages": ["chinese"],
      "loader": "cmmlu",
      "language_caps": { "chinese": 3000 },
      "max_per_dataset": 3000,
      "split_caps": { "val": 300, "test": 0 }
    },

    "milu": {
      "languages": ["hindi"],
      "loader": "milu",
      "max_per_language": 3000,
      "max_per_dataset": 3000,
      "split_caps": { "val": 300, "test": 0 }
    },

    "mera": {
      "languages": ["russian"],
      "loader": "mera",
      "max_per_language": 2000,
      "max_per_dataset": 2000,
      "stratify_by": "subset",
      "subject_caps": {
        "mamuramu": 500,
        "ruopenbookqa": 500,
        "ruworldtree": 500,
        "mathlogicqa": 500,
        "parus": 400,
        "use": 0,
        "rcb": 0,
        "rwsd": 0
      },
      "split_caps": { "val": 300, "test": 0 }
    },

    "head_qa": {
      "languages": ["spanish", "italian"],
      "loader": "head_qa",
      "language_caps": { "spanish": 1500, "italian": 0 },
      "max_per_dataset": 1500,
      "split_caps": { "val": 150, "test": 0 }
    },

    "exams": {
      "languages": ["italian", "spanish"],
      "loader": "exams",
      "max_per_language": 1500,
      "max_per_dataset": 3000,
      "split_caps": { "val": 150, "test": 0 }
    },

    "polizia_di_stato_clean": {
      "languages": ["italian"],
      "loader": "polizia_di_stato",
      "max_per_language": 250,
      "max_per_dataset": 250,
      "split_caps": { "val": 50, "test": 0 }
    },

    "quaderno_prefettizia_clean": {
      "languages": ["italian"],
      "loader": "quaderno_prefettizia",
      "max_per_language": 400,
      "max_per_dataset": 400,
      "split_caps": { "val": 60, "test": 0 }
    },

    "quaderno_prefettizia_economia_politica_clean": {
      "languages": ["italian"],
      "loader": "quaderno_prefettizia_economia_politica",
      "max_per_language": 250,
      "max_per_dataset": 250,
      "split_caps": { "val": 50, "test": 0 }
    },

    "italian_civil_code": {
      "languages": ["italian"],
      "loader": "italian_civil_code",
      "max_per_language": 400,
      "max_per_dataset": 400,
      "split_caps": { "val": 60, "test": 0 }
    },

    "spain_boe_legislation": {
      "languages": ["spanish"],
      "loader": "spain_boe_legislation",
      "max_per_language": 700,
      "max_per_dataset": 700,
      "split_caps": { "val": 80, "test": 0 }
    }
  }
}