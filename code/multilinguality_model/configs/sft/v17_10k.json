{
  "output_name": "v17_10k",
  "notes": "Non-thinking boxed-only SFT. ~10k total / ~2k per language. Lower Global MMLU cap. Heavy MILU/CEVAL/CMMLU, moderate MERA, all INCLUDE and Global PIQA, more EXAMS/HEAD-QA, small generated Italian/Spanish cap.",
  "mode": "non_thinking",
  "non_thinking_style": "boxed_only",
  "enable_test_split": false,

  "max_per_language": 3000,
  "max_per_dataset": 20000,
  "max_per_language_mixed": 2000,
  "max_per_language_mixed_val": 200,

  "benchmark_path": "data/multilinguality/benchmarks/benchmark_all.jsonl",

  "dataset_registry": {
    "include": {
      "languages": ["italian", "spanish", "russian", "chinese", "hindi"],
      "loader": "include",
      "mode": "as_is",
      "max_per_language": 3000,
      "max_per_dataset": 15000,
      "split_caps": { "val": 500, "test": 0 }
    },

    "global_piqa": {
      "languages": ["italian", "spanish", "russian", "chinese", "hindi"],
      "loader": "global_piqa",
      "mode": "as_is",
      "max_per_language": 1500,
      "max_per_dataset": 7500,
      "split_caps": { "val": 200, "test": 0 }
    },

    "global_mmlu": {
      "languages": ["russian", "chinese", "hindi", "italian", "spanish"],
      "loader": "global_mmlu",
      "language_caps": {
        "russian": 500,
        "chinese": 500,
        "hindi": 500,
        "italian": 500,
        "spanish": 500
      },
      "max_per_dataset": 2500,
      "split_caps": { "val": 200, "test": 0 }
    },

    "ceval": {
      "languages": ["chinese"],
      "loader": "ceval",
      "language_caps": { "chinese": 2000 },
      "max_per_dataset": 2000,
      "split_caps": { "val": 200, "test": 0 }
    },

    "cmmlu": {
      "languages": ["chinese"],
      "loader": "cmmlu",
      "language_caps": { "chinese": 2000 },
      "max_per_dataset": 2000,
      "split_caps": { "val": 200, "test": 0 }
    },

    "milu": {
      "languages": ["hindi"],
      "loader": "milu",
      "max_per_language": 2000,
      "max_per_dataset": 2000,
      "split_caps": { "val": 200, "test": 0 }
    },

    "mera": {
      "languages": ["russian"],
      "loader": "mera",
      "max_per_language": 2000,
      "max_per_dataset": 2000,
      "stratify_by": "subset",
      "subject_caps": {
        "mamuramu": 500,
        "ruopenbookqa": 500,
        "ruworldtree": 500,
        "mathlogicqa": 500,
        "parus": 400,
        "use": 0,
        "rcb": 0,
        "rwsd": 0
      },
      "split_caps": { "val": 300, "test": 0 }
    },

    "head_qa": {
      "languages": ["spanish", "italian"],
      "loader": "head_qa",
      "language_caps": { "spanish": 800, "italian": 0 },
      "max_per_dataset": 800,
      "split_caps": { "val": 80, "test": 0 }
    },

    "exams": {
      "languages": ["italian", "spanish"],
      "loader": "exams",
      "max_per_language": 800,
      "max_per_dataset": 1600,
      "split_caps": { "val": 80, "test": 0 }
    },

    "polizia_di_stato_clean": {
      "languages": ["italian"],
      "loader": "polizia_di_stato",
      "max_per_language": 200,
      "max_per_dataset": 200,
      "split_caps": { "val": 30, "test": 0 }
    },

    "quaderno_prefettizia_clean": {
      "languages": ["italian"],
      "loader": "quaderno_prefettizia",
      "max_per_language": 300,
      "max_per_dataset": 300,
      "split_caps": { "val": 40, "test": 0 }
    },

    "quaderno_prefettizia_economia_politica_clean": {
      "languages": ["italian"],
      "loader": "quaderno_prefettizia_economia_politica",
      "max_per_language": 200,
      "max_per_dataset": 200,
      "split_caps": { "val": 30, "test": 0 }
    },

    "italian_civil_code": {
      "languages": ["italian"],
      "loader": "italian_civil_code",
      "max_per_language": 300,
      "max_per_dataset": 300,
      "split_caps": { "val": 40, "test": 0 }
    },

    "spain_boe_legislation": {
      "languages": ["spanish"],
      "loader": "spain_boe_legislation",
      "max_per_language": 500,
      "max_per_dataset": 500,
      "split_caps": { "val": 60, "test": 0 }
    }
  }
}