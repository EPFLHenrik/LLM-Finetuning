{
  "output_name": "v18",
  "notes": "Non-thinking SFT. ~15k total / ~3k per language. All INCLUDE and Global PIQA uncapped. Moderate Global MMLU (500/lang). Heavy MMLU-ProX (1000/lang). Language-specific: MERA+RuBQ for Russian, CEVAL+CMMLU for Chinese, MILU for Hindi, EXAMS+generated for Italian, HEAD-QA+BOE for Spanish. MGSM 200/lang for math. Benchmark filtering enabled.",
  "mode": "non_thinking",
  "non_thinking_style": "boxed_only",
  "enable_test_split": false,

  "max_per_language": 5000,
  "max_per_dataset": 20000,
  "max_per_language_mixed": 3000,
  "max_per_language_mixed_val": 400,

  "benchmark_path": "data/multilinguality/benchmarks/benchmark_all.jsonl",

  "dataset_registry": {
    "include": {
      "languages": ["italian", "spanish", "russian", "chinese", "hindi"],
      "loader": "include",
      "mode": "as_is",
      "max_per_language": 3000,
      "max_per_dataset": 15000,
      "split_caps": { "val": 500, "test": 0 }
    },

    "global_piqa": {
      "languages": ["italian", "spanish", "russian", "chinese", "hindi"],
      "loader": "global_piqa",
      "mode": "as_is",
      "max_per_language": 1500,
      "max_per_dataset": 7500,
      "split_caps": { "val": 200, "test": 0 }
    },

    "global_mmlu": {
      "languages": ["russian", "chinese", "hindi", "italian", "spanish"],
      "loader": "global_mmlu",
      "language_caps": {
        "russian": 400,
        "chinese": 400,
        "hindi": 400,
        "italian": 400,
        "spanish": 400
      },
      "max_per_dataset": 2000,
      "split_caps": { "val": 200, "test": 0 }
    },

    "mmlu_prox": {
      "languages": ["russian", "chinese", "hindi", "italian", "spanish"],
      "loader": "mmlu_prox",
      "language_caps": {
        "russian": 1200,
        "chinese": 1200,
        "hindi": 1200,
        "italian": 1200,
        "spanish": 1200
      },
      "max_per_dataset": 5000,
      "split_caps": { "val": 500, "test": 0 }
    },

    "mgsm": {
      "languages": ["russian", "chinese", "hindi", "italian", "spanish"],
      "loader": "mgsm",
      "language_caps": {
        "russian": 200,
        "chinese": 200,
        "hindi": 200,
        "italian": 200,
        "spanish": 200
      },
      "max_per_dataset": 1000,
      "split_caps": { "val": 50, "test": 0 }
    },

    "ceval": {
      "languages": ["chinese"],
      "loader": "ceval",
      "language_caps": { "chinese": 800 },
      "max_per_dataset": 800,
      "split_caps": { "val": 200, "test": 0 }
    },

    "cmmlu": {
      "languages": ["chinese"],
      "loader": "cmmlu",
      "language_caps": { "chinese": 800 },
      "max_per_dataset": 800,
      "split_caps": { "val": 200, "test": 0 }
    },

    "milu": {
      "languages": ["hindi"],
      "loader": "milu",
      "max_per_language": 1500,
      "max_per_dataset": 1500,
      "split_caps": { "val": 300, "test": 0 }
    },

    "mera": {
      "languages": ["russian"],
      "loader": "mera",
      "max_per_language": 1000,
      "max_per_dataset": 1000,
      "stratify_by": "subset",
      "subject_caps": {
        "mamuramu": 300,
        "ruopenbookqa": 250,
        "ruworldtree": 200,
        "mathlogicqa": 200,
        "parus": 200,
        "use": 0,
        "rcb": 0,
        "rwsd": 0
      },
      "split_caps": { "val": 200, "test": 0 }
    },

    "rubq": {
      "languages": ["russian"],
      "loader": "rubq",
      "max_per_language": 300,
      "max_per_dataset": 300,
      "split_caps": { "val": 150, "test": 0 }
    },

    "head_qa": {
      "languages": ["spanish"],
      "loader": "head_qa",
      "language_caps": { "spanish": 600 },
      "max_per_dataset": 600,
      "split_caps": { "val": 100, "test": 0 }
    },

    "exams": {
      "languages": ["italian", "spanish"],
      "loader": "exams",
      "language_caps": { "italian": 600, "spanish": 200 },
      "max_per_dataset": 800,
      "split_caps": { "val": 100, "test": 0 }
    },

    "polizia_di_stato_clean": {
      "languages": ["italian"],
      "loader": "polizia_di_stato",
      "max_per_language": 100,
      "max_per_dataset": 100,
      "split_caps": { "val": 25, "test": 0 }
    },

    "quaderno_prefettizia_clean": {
      "languages": ["italian"],
      "loader": "quaderno_prefettizia",
      "max_per_language": 100,
      "max_per_dataset": 100,
      "split_caps": { "val": 25, "test": 0 }
    },

    "quaderno_prefettizia_economia_politica_clean": {
      "languages": ["italian"],
      "loader": "quaderno_prefettizia_economia_politica",
      "max_per_language": 100,
      "max_per_dataset": 100,
      "split_caps": { "val": 25, "test": 0 }
    },

    "italian_civil_code": {
      "languages": ["italian"],
      "loader": "italian_civil_code",
      "max_per_language": 100,
      "max_per_dataset": 100,
      "split_caps": { "val": 25, "test": 0 }
    },

    "spain_boe_legislation": {
      "languages": ["spanish"],
      "loader": "spain_boe_legislation",
      "max_per_language": 300,
      "max_per_dataset": 300,
      "split_caps": { "val": 50, "test": 0 }
    }
  }
}